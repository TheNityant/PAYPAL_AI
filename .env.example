# IntentParity local-only development. Never commit actual credentials.
# Cloud AI: Nebius Token Factory (recommended for hackathon)
LLM_PROVIDER=nebius
LLM_MODEL=
NEBIUS_API_KEY=
# Optional: custom OpenAI-compatible Chat Completions service.
# LLM_PROVIDER=compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# Local Ollama alternative: provider=compatible, URL=http://127.0.0.1:11434/v1
# When no model is configured the UI explicitly uses heuristic-only mode.

# PayPal Sandbox only; real funds unsupported.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
ENABLE_SANDBOX_CHECKOUT=false
